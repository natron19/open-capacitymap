<%# Section 1 — Inventory summary %>
<div class="card mb-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start mb-3">
      <h2 class="h4 mb-0">Your Gift Inventory</h2>
      <%= link_to "Edit", edit_gift_inventory_path(@inventory), class: "btn btn-sm btn-outline-secondary" %>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-md-6">
        <p class="small text-muted mb-1 fw-semibold">Skills</p>
        <div class="d-flex flex-wrap gap-1">
          <% @inventory.skills_list.each do |s| %>
            <span class="chip-tag chip-tag--skill"><%= s %></span>
          <% end %>
        </div>
      </div>
      <div class="col-md-6">
        <p class="small text-muted mb-1 fw-semibold">Interests</p>
        <div class="d-flex flex-wrap gap-1">
          <% @inventory.interests_list.each do |s| %>
            <span class="chip-tag chip-tag--interest"><%= s %></span>
          <% end %>
        </div>
      </div>
      <div class="col-md-6">
        <p class="small text-muted mb-1 fw-semibold">Connections</p>
        <div class="d-flex flex-wrap gap-1">
          <% @inventory.connections_list.each do |s| %>
            <span class="chip-tag chip-tag--connection"><%= s %></span>
          <% end %>
        </div>
      </div>
      <div class="col-md-6">
        <p class="small text-muted mb-1 fw-semibold">Experience Areas</p>
        <div class="d-flex flex-wrap gap-1">
          <% @inventory.experience_areas_list.each do |s| %>
            <span class="chip-tag chip-tag--experience"><%= s %></span>
          <% end %>
        </div>
      </div>
      <div class="col-md-6">
        <p class="small text-muted mb-1 fw-semibold">Weekly Hours</p>
        <span class="fw-semibold"><%= @inventory.weekly_hours %> hrs / week</span>
      </div>
      <div class="col-12">
        <p class="small text-muted mb-1 fw-semibold">Organization or Community</p>
        <p class="mb-0 small"><%= @inventory.organization_context %></p>
      </div>
    </div>

    <%= button_to "Generate Projects", generate_gift_inventory_path(@inventory),
          method: :post,
          class: "btn fw-semibold",
          style: "background:var(--accent);color:#000;",
          form: { data: {
            controller: "generate",
            action: "submit->generate#start",
            generate_cancel_path_value: gift_inventory_path(@inventory),
            turbo_frame: "_top"
          } } %>
  </div>
</div>

<%# Section 2 — Project ideas %>
<% if @project_ideas.empty? %>
  <div class="text-center py-5 text-muted">
    <p class="mb-3">No projects generated yet.</p>
    <%= button_to "Generate Projects", generate_gift_inventory_path(@inventory),
          method: :post,
          class: "btn fw-semibold",
          style: "background:var(--accent);color:#000;",
          form: { data: {
            controller: "generate",
            action: "submit->generate#start",
            generate_cancel_path_value: gift_inventory_path(@inventory)
          } } %>
  </div>
<% else %>
  <p class="text-muted fst-italic small mb-3">
    These are AI-suggested starting points, not commitments.
    Validate fit with your community before acting.
  </p>
  <div class="row">
    <% @project_ideas.each do |idea| %>
      <div class="col-lg-4 col-md-6 col-12 mb-4">
        <div class="card h-100 project-card">
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0" style="color:var(--accent);">
                <%= link_to idea.name, project_idea_path(idea), style: "color:inherit;text-decoration:none;" %>
              </h5>
              <div class="ms-2 flex-shrink-0" style="max-width:110px;">
                <% if idea.time_commitment.present? %>
                  <span class="badge bg-secondary d-block mb-1 text-truncate" title="<%= idea.time_commitment %>"><%= idea.time_commitment %></span>
                <% end %>
                <% if idea.impact_type.present? %>
                  <span class="badge bg-secondary d-block text-truncate" title="<%= idea.impact_type %>"><%= idea.impact_type %></span>
                <% end %>
              </div>
            </div>

            <p class="card-text small mb-3"><%= idea.description %></p>

            <% if idea.gifts_used_list.any? %>
              <p class="small fw-semibold mb-1">Gifts this draws on:</p>
              <div class="d-flex flex-wrap gap-1 mb-3">
                <% idea.gifts_used_list.each do |gift| %>
                  <span class="chip-tag chip-tag--<%= gift["category"] %>"><%= gift["name"] %></span>
                <% end %>
              </div>
            <% end %>

            <div class="first-step-alert p-2 rounded small mb-3 mt-auto">
              <strong>First step this week:</strong> <%= idea.first_step %>
            </div>

            <div class="d-flex align-items-center justify-content-between">
              <a class="btn btn-sm btn-outline-secondary"
                 data-bs-toggle="collapse"
                 href="#raw-<%= idea.id %>">Show raw response</a>
              <%= button_to "Remove", project_idea_path(idea), method: :delete,
                    class: "btn btn-sm btn-outline-danger" %>
            </div>
            <div class="collapse mt-2" id="raw-<%= idea.id %>">
              <pre class="bg-dark p-2 rounded small text-muted" style="white-space:pre-wrap;"><%= idea.gemini_raw %></pre>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
