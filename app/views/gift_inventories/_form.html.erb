<%= form_with model: gift_inventory do |f| %>
  <% if gift_inventory.errors.any? %>
    <div class="alert alert-danger mb-4">
      <ul class="mb-0">
        <% gift_inventory.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Skills: 5–8 chips %>
  <div class="mb-3"
       data-controller="chip-tags"
       data-chip-tags-min-value="5"
       data-chip-tags-max-value="8"
       data-chip-tags-category-value="skill">
    <label class="form-label fw-semibold">Skills you enjoy using</label>
    <div data-chip-tags-target="chips" class="d-flex flex-wrap gap-1 mb-2" style="min-height:2rem;"></div>
    <input type="text"
           data-chip-tags-target="input"
           data-action="keydown->chip-tags#onKeydown"
           class="form-control"
           placeholder="Type a skill and press Enter">
    <%= f.hidden_field :skills, data: { "chip-tags-target": "hidden" } %>
    <div class="invalid-feedback">Must have between 5 and 8 skills.</div>
    <div class="form-text">5 to 8 skills. Press Enter or comma to add each one.</div>
  </div>

  <%# Interests: 3–5 chips %>
  <div class="mb-3"
       data-controller="chip-tags"
       data-chip-tags-min-value="3"
       data-chip-tags-max-value="5"
       data-chip-tags-category-value="interest">
    <label class="form-label fw-semibold">Interests and causes you care about</label>
    <div data-chip-tags-target="chips" class="d-flex flex-wrap gap-1 mb-2" style="min-height:2rem;"></div>
    <input type="text"
           data-chip-tags-target="input"
           data-action="keydown->chip-tags#onKeydown"
           class="form-control"
           placeholder="Type an interest and press Enter">
    <%= f.hidden_field :interests, data: { "chip-tags-target": "hidden" } %>
    <div class="invalid-feedback">Must have between 3 and 5 interests.</div>
    <div class="form-text">3 to 5 interests. What causes pull at you?</div>
  </div>

  <%# Weekly hours: reuses temperature-slider controller — no inline JS %>
  <div class="mb-3" data-controller="temperature-slider">
    <label class="form-label fw-semibold">
      Hours available per week:
      <strong data-temperature-slider-target="display"><%= gift_inventory.weekly_hours || 6 %></strong>
    </label>
    <%= f.range_field :weekly_hours,
          min: 1, max: 40, step: 1,
          class: "form-range",
          data: {
            "temperature-slider-target": "slider",
            action: "input->temperature-slider#update"
          } %>
  </div>

  <%# Connections: 3–5 chips %>
  <div class="mb-3"
       data-controller="chip-tags"
       data-chip-tags-min-value="3"
       data-chip-tags-max-value="5"
       data-chip-tags-category-value="connection">
    <label class="form-label fw-semibold">Connections you could activate</label>
    <div data-chip-tags-target="chips" class="d-flex flex-wrap gap-1 mb-2" style="min-height:2rem;"></div>
    <input type="text"
           data-chip-tags-target="input"
           data-action="keydown->chip-tags#onKeydown"
           class="form-control"
           placeholder="Type a connection and press Enter">
    <%= f.hidden_field :connections, data: { "chip-tags-target": "hidden" } %>
    <div class="invalid-feedback">Must have between 3 and 5 connections.</div>
    <div class="form-text">3 to 5 people or networks you could bring in.</div>
  </div>

  <%# Experience areas: 1+ chips %>
  <div class="mb-3"
       data-controller="chip-tags"
       data-chip-tags-min-value="1"
       data-chip-tags-max-value="20"
       data-chip-tags-category-value="experience">
    <label class="form-label fw-semibold">Experience areas</label>
    <div data-chip-tags-target="chips" class="d-flex flex-wrap gap-1 mb-2" style="min-height:2rem;"></div>
    <input type="text"
           data-chip-tags-target="input"
           data-action="keydown->chip-tags#onKeydown"
           class="form-control"
           placeholder="Type an area and press Enter">
    <%= f.hidden_field :experience_areas, data: { "chip-tags-target": "hidden" } %>
    <div class="invalid-feedback">At least 1 experience area is required.</div>
    <div class="form-text">Industries, domains, or communities you know well.</div>
  </div>

  <div class="mb-4">
    <%= f.label :organization_context, "Your organization or community", class: "form-label fw-semibold" %>
    <%= f.text_area :organization_context, class: "form-control", rows: 5,
          placeholder: "What is your organization or community? Mission, current focus, member type. (50–1000 characters)" %>
    <div class="form-text">Describe the context where you'd apply these gifts.</div>
  </div>

  <%= f.submit gift_inventory.new_record? ? "Create Inventory" : "Save Changes",
        class: "btn fw-semibold",
        style: "background:var(--accent);color:#000;" %>
<% end %>
