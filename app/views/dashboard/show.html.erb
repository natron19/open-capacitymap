<% inventory = current_user.gift_inventory %>

<% if inventory.nil? %>
  <div class="text-center py-5">
    <h2 class="mb-2">Welcome to <%= ENV.fetch("APP_NAME", "CapacityMap Demo") %></h2>
    <p class="text-muted mb-4">Start by inventorying the gifts you bring to your community.</p>
    <%= link_to "Create Your Gift Inventory", new_gift_inventory_path,
          class: "btn btn-lg fw-semibold",
          style: "background:var(--accent);color:#000;" %>
  </div>

<% elsif inventory.project_ideas.empty? %>
  <h2 class="mb-1">Your Gift Inventory</h2>
  <p class="text-muted mb-4">Inventory saved. Generate your first project ideas.</p>
  <div class="d-flex flex-wrap gap-1 mb-4">
    <% inventory.skills_list.each do |s| %>
      <span class="chip-tag chip-tag--skill"><%= s %></span>
    <% end %>
  </div>
  <%= button_to "Generate Projects", generate_gift_inventory_path(inventory),
        method: :post,
        class: "btn fw-semibold",
        style: "background:var(--accent);color:#000;" %>

<% else %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Your Latest Projects</h2>
    <%= link_to "See all", project_ideas_path, class: "text-muted small" %>
  </div>
  <div class="row g-3">
    <% inventory.project_ideas.ordered.limit(3).each do |idea| %>
      <div class="col-lg-4 col-md-6 col-12">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title"><%= link_to idea.name, project_idea_path(idea) %></h5>
            <p class="card-text small text-muted"><%= idea.description.truncate(100) %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
